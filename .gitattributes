# Exclude symlinked agent files from formatting
.claude/agents/*.agent.md rules-lint-ignored=true
CLAUDE.md rules-lint-ignored=true
# Test inputs for the Groovy formatter, deliberately not formatted
bazel/tools/format/tests/component/groovy/*.groovy rules-lint-ignored=true

# Use git's built-in Rust funcname pattern so diff hunk headers report the
# enclosing fn/impl/mod instead of git's generic fallback context.
*.rs diff=rust
