load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@cmk_requirements//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_uv//uv:pip.bzl", "pip_compile")
load("@windows_python_wheels//:requirements.bzl", "all_whl_requirements")
load("//:package_versions.bzl", "PYTHON_VERSION_WINDOWS")
load("//bazel/rules:requirements.bzl", "compile_requirements_in")
load(":python_cab.bzl", "python_cab", "python_msi_tree", "python_version_major_minor")
load(":python_msis.bzl", "PYTHON_MSI_FEATURES")

exports_files([
    "windows-constraints.txt",
    "windows-requirements.in",
    "windows-requirements.txt",
])

_PY_WIN_MAJOR_MINOR = python_version_major_minor(PYTHON_VERSION_WINDOWS)

# Linux runtime of the CAB's interpreter line (use_repo'd in
# //bazel/module:py.MODULE.bazel); uv resolves the lock under it.
_PY_WIN_RESOLVER_RUNTIME = "@python_{}_x86_64-unknown-linux-gnu//:py3_runtime".format(
    _PY_WIN_MAJOR_MINOR.replace(".", "_"),
)

# Pure-Python CAB writer driver, vendored via @cabarchive (LGPL-2.1-or-later).
# Replaces the historical gcab/makecab.exe dependency.
py_binary(
    name = "pack_cab",
    srcs = ["pack_cab.py"],
    main = "pack_cab.py",
    visibility = ["//visibility:public"],
    deps = ["@cabarchive"],
)

# MSI extractor — drives msiinfo (from @msitools) and cabextract (from
# @cabextract) to unpack a Windows MSI on Linux.  Replaces upstream
# msitools' Vala-based ``msiextract`` (which doesn't build cleanly against
# modern glib).
py_binary(
    name = "extract_msi",
    srcs = ["extract_msi.py"],
    main = "extract_msi.py",
    visibility = ["//visibility:public"],
)

# Offline pip driver — runs the sha256-pinned pip wheel from the closure
# under the CAB's major.minor CPython, so pip-written metadata (RECORD
# bytecode tags, versioned script names) matches the CAB's Python.
py_binary(
    name = "pip_offline",
    srcs = ["pip_offline.py"],
    main = "pip_offline.py",
    python_version = _PY_WIN_MAJOR_MINOR,
    visibility = ["//visibility:public"],
)

# Rebuilds the Windows console-script .exe launchers (distlib stub + shebang
# + zipped __main__.py) that a native Windows pip install would have put
# into .venv/Scripts.
py_binary(
    name = "make_exe_wrappers",
    srcs = ["make_exe_wrappers.py"],
    main = "make_exe_wrappers.py",
    visibility = ["//visibility:public"],
)

# virtualenv-style activation scripts shipped in .venv/Scripts, with the
# production install path baked in (the historic Windows build baked the
# build machine's path instead, breaking them on customer hosts).
filegroup(
    name = "venv_scripts",
    srcs = glob(["venv_scripts/*"]),
)

# The actions of python_cab.bzl's rules.
sh_binary(
    name = "build_python_cab",
    srcs = ["build_python_cab.sh"],
)

compile_requirements_in(
    name = "windows-requirements-in",
    constraints = [":windows-constraints.txt"],
    requirements = [":windows-requirements.in"],
)

pip_compile(
    name = "windows_requirements",
    extra_args = [
        # Fail loudly if any (transitive) dep lacks a win_amd64 wheel rather
        # than silently resolving an sdist the hub cannot build.
        "--only-binary=:all:",
    ],
    py3_runtime = _PY_WIN_RESOLVER_RUNTIME,
    python_platform = "x86_64-pc-windows-msvc",
    requirements_in = ":windows-requirements-in",
    requirements_txt = ":windows-requirements.txt",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Maintainer tool: recomputes the sha256 hashes for the python.org per-feature
# MSIs and prints the _MSI_SHA256 map for
# //bazel/extensions:python_cab_repositories.bzl.  Run after bumping
# PYTHON_VERSION_WINDOWS in //:package_versions.bzl -- which it reads through
# args below, as it does PYTHON_MSI_FEATURES, so the hashes cannot be fetched
# for a different version or set of MSIs than the extension requests.
py_binary(
    name = "refresh_msi_pins",
    srcs = ["refresh_msi_pins.py"],
    args = ["--python-version=" + PYTHON_VERSION_WINDOWS] + [
        "--msi=" + f
        for f in PYTHON_MSI_FEATURES
    ],
    main = "refresh_msi_pins.py",
    visibility = ["//visibility:public"],
)

# cabextract (LZX-capable CAB extractor) from the @cabextract bcr module —
# needed because cabarchive only supports MSZIP and None compression, while
# python.org MSIs ship LZX-compressed cabinets.
filegroup(
    name = "_cabextract",
    srcs = ["@cabextract"],
    output_group = "cabextract",
)

python_msi_tree(name = "python_tree")

python_cab(
    name = "python_3_cab",
    postinstall_cmd = "postinstall.cmd",
    python_tree = ":python_tree",
    venv_scripts = [":venv_scripts"],
    visibility = ["//visibility:public"],
    wheels = all_whl_requirements,
)

py_test(
    name = "cab_contents_test",
    srcs = ["cab_contents_test.py"],
    args = ["--import-mode=importlib"],
    data = [":python_3_cab"],
    env = {"PYTHON_CAB": "$(rootpath :python_3_cab)"},
    pytest_main = True,
    deps = [
        "@cabarchive",
        requirement("coverage"),
        requirement("pytest"),
    ],
)
