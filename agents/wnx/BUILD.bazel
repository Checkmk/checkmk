load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("//bazel/rules:xcomp/cc.bzl", "cc_binary")
load("//bazel/toolchains/cc/clang/xwin:rc.bzl", "windows_rc")

package(features = ["treat_warnings_as_errors"])

# The AdditionalOptions of the vcxproj builds; without /Zc:char8_t- the
# char8_t-blind formatting code (e.g. common/fmt_ext.h) doesn't compile.
WNX_COPTS = [
    "/utf-8",
    "/Zc:char8_t-",
]

# Mirrors PreprocessorDefinitions of the vcxproj builds.
WNX_DEFINES = [
    "_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING",
    "_LIB",
    "UNICODE",
    "_UNICODE",
    'SOLUTION_DIR=uR\\"(agents/wnx)\\"',
]

# The core Win32 import libraries MSBuild links implicitly (the inherited
# %(AdditionalDependencies) default set); sources request the rest via
# #pragma comment(lib, ...).
WNX_DEFAULT_LINKOPTS = [
    "/DEFAULTLIB:kernel32.lib",
    "/DEFAULTLIB:user32.lib",
    "/DEFAULTLIB:gdi32.lib",
    "/DEFAULTLIB:winspool.lib",
    "/DEFAULTLIB:comdlg32.lib",
    "/DEFAULTLIB:advapi32.lib",
    "/DEFAULTLIB:shell32.lib",
    "/DEFAULTLIB:ole32.lib",
    "/DEFAULTLIB:oleaut32.lib",
    "/DEFAULTLIB:uuid.lib",
    "/DEFAULTLIB:odbc32.lib",
    "/DEFAULTLIB:odbccp32.lib",
]

windows_rc(
    name = "check_mk_service_res",
    src = "src/check_mk_service.rc",
    hdrs = [
        "include/common/version.h",
        "include/common/wnx_version.h",
        "src/resource.h",
    ],
    includes = [
        "include",
        "src",
    ],
    tags = ["manual"],
)

windows_rc(
    name = "check_mk_service_manifest_res",
    src = "src/check_mk_service_manifest.rc",
    hdrs = ["check_mk.manifest"],
    includes = ["."],
    tags = ["manual"],
)

cc_binary(
    name = "check_mk_service-windows",
    srcs = [
        "src/main/check_mk_service.cpp",
        "src/main/check_mk_service.h",
        "src/main/pch.cpp",
        "src/main/pch.h",
    ],
    additional_linker_inputs = [
        ":check_mk_service_res",
        ":check_mk_service_manifest_res",
    ],
    copts = WNX_COPTS,
    linkopts = WNX_DEFAULT_LINKOPTS + [
        "/SUBSYSTEM:CONSOLE",
        "/DEFAULTLIB:userenv.lib",
        "$(location :check_mk_service_res)",
        "$(location :check_mk_service_manifest_res)",
    ],
    local_defines = [
        # Mirrors PreprocessorDefinitions in check_mk_service.vcxproj.
        'CMK_SERVICE_NAME=\\"check_mk_service\\"',
        "_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING",
        "_CONSOLE",
        "UNICODE",
        "_UNICODE",
    ],
    opt = True,
    platform = "//bazel/platforms:x86_64-windows-msvc",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        ":engine",
        ":wnx_headers",
        "@asio",
        "@wnx_fmt//:fmt",
        "@wnx_yaml_cpp//:yaml-cpp",
    ],
)

cc_library(
    name = "wnx_headers",
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_library(
    name = "wnx_common",
    srcs = glob(["src/common/*.cpp"]) + [
        "src/engine/stdafx.h",
    ],
    copts = WNX_COPTS + [
        "/Iagents/wnx/src/engine",
    ],
    local_defines = WNX_DEFINES,
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    deps = [
        ":wnx_headers",
        "@asio",
        "@wnx_fmt//:fmt",
        "@wnx_yaml_cpp//:yaml-cpp",
    ],
)

cc_library(
    name = "wnx_lwa",
    srcs = glob([
        "src/lwa/*.cc",
        "src/lwa/*.cpp",
    ]) + ["src/engine/stdafx.h"],
    copts = WNX_COPTS + [
        "/Iagents/wnx/src/engine",
        "/Iagents/wnx/include/lwa",
    ],
    local_defines = WNX_DEFINES,
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    deps = [
        ":wnx_headers",
        "@asio",
        "@wnx_fmt//:fmt",
        "@wnx_simpleini//:simpleini",
        "@wnx_yaml_cpp//:yaml-cpp",
    ],
)

cc_library(
    name = "engine",
    srcs = glob([
        "src/engine/*.cpp",
        "src/engine/*.h",
        "src/engine/eventlog/*.cpp",
        "src/engine/providers/*.cpp",
    ]),
    copts = WNX_COPTS + [
        "/Iagents/wnx/src/engine",
    ],
    local_defines = WNX_DEFINES,
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    deps = [
        ":wnx_common",
        ":wnx_headers",
        ":wnx_lwa",
        "@asio",
        "@wnx_fmt//:fmt",
        "@wnx_yaml_cpp//:yaml-cpp",
    ],
)

py_binary(
    name = "patch_windows_agent_version",
    srcs = ["patch_windows_agent_version.py"],
    main = "patch_windows_agent_version.py",
    visibility = ["//visibility:public"],
)
