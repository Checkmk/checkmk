<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional configuration for OpenHardwareMonitorCLI.exe (LibreHardwareMonitor edition).
  Rename to "OpenHardwareMonitorCLI.exe.config" and put it next to the EXE
  (Checkmk agent: C:\ProgramData\checkmk\agent\bin\). Restart the agent afterwards.
  Without this file the defaults below apply.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Additional hardware groups: cpu, gpu, memory, motherboard, controller, storage,
         network, psu, battery, powermonitor, all.
         Default enabled (like the original OHM CLI): cpu, memory, motherboard, controller, storage -->
    <add key="Enable" value="" />
    <add key="Disable" value="" />

    <!-- Update interval in milliseconds (default 1000) -->
    <add key="IntervalMs" value="1000" />

    <!-- true  = OpenHardwareMonitor compatible identifiers (/hdd/0, /nvidiagpu/0, /mainboard ...)
               -> existing Checkmk services keep their names
         false = native LibreHardwareMonitor identifiers (/nvme/0, /gpu-nvidia/0, /motherboard ...) -->
    <add key="CompatIdentifiers" value="true" />

    <!-- Optional log file (relative paths are relative to the EXE), e.g. OpenHardwareMonitorCLI.log -->
    <add key="LogFile" value="" />
    <add key="Verbose" value="false" />
  </appSettings>
</configuration>
