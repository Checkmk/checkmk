<?xml version="1.0" encoding="utf-8"?>
<!-- Always use nuget.org for this project, regardless of machine-wide NuGet sources. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
