# Repositories of the python-3.cab build (agents/modules/windows): the
# python-build-standalone interpreter, the CAB writer, and the win_amd64 wheel
# closure.
python_cab = use_extension("//bazel/extensions:python_cab_repositories.bzl", "repos")
use_repo(
    python_cab,
    "cabarchive",
    "python_windows_standalone",
    "pyyaml_sdist",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "windows_python_wheels",
    python_version = "3.15",
    requirements_by_platform = {
        "@//agents/modules/windows:windows-requirements.txt": "windows_x86_64",
    },
    target_platforms = ["windows_x86_64"],
)
use_repo(pip, "windows_python_wheels")

# The test closure of //agents/modules/windows:python_test_cab, the harness
# Python of the Windows agent's pytest suites in their QEMU tiers.
pip.parse(
    hub_name = "windows_test_python_wheels",
    python_version = "3.15",
    requirements_by_platform = {
        "@//agents/modules/windows:windows-test-cab-requirements.txt": "windows_x86_64",
    },
    target_platforms = ["windows_x86_64"],
)
use_repo(pip, "windows_test_python_wheels")
