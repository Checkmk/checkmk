# Repositories of the python-3.cab build (agents/modules/windows): the
# python.org per-feature MSIs, the CAB writer, and the win_amd64 wheel closure.
python_cab = use_extension("//bazel/extensions:python_cab_repositories.bzl", "repos")
use_repo(
    python_cab,
    "cabarchive",
    "python_msi_core",
    "python_msi_exe",
    "python_msi_lib",
    "python_msi_pip",
    "python_msi_ucrt",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # rules_python 1.6.0 only cross-resolves through the bazel downloader:
    # without an index url it shells out to the host pip, which cannot fetch a
    # win_amd64-only wheel like pywin32.  2.x, which master is on, does this by
    # default and spells experimental_target_platforms target_platforms.
    experimental_index_url = "https://pypi.org/simple",
    experimental_target_platforms = ["windows_x86_64"],
    hub_name = "windows_python_wheels",
    python_version = "3.13",
    requirements_by_platform = {
        "@//agents/modules/windows:requirements-windows.txt": "windows_x86_64",
    },
)
use_repo(pip, "windows_python_wheels")
