# Build dependencies of the C++ Windows agent (agents/wnx).

wnx_repos = use_extension("//bazel/module:wnx_repositories.bzl", "repos")
use_repo(
    wnx_repos,
    "wine_linux_x86_64",
    "wine_mono",
    "wix3",
)

# The Windows test VM (agents/wnx/test-vm): the media its image is built
# from. Not build dependencies: only the image build fetches them.
# Not exported as `repos`, like most extensions here: Bzlmod numbers
# same-named extensions in use order, so one more `repos` would rename the
# repositories of every later one.
test_vm_repos = use_extension("//bazel/extensions:test_vm_repositories.bzl", "test_vm")
use_repo(
    test_vm_repos,
    "msodbcsql17_msi",
    "mssql2022_cu",
    "mssql2022_dev_iso",
    "virtio_win_iso",
    "win2022_eval_iso",
)

# Vendored dependencies of the C++ Windows agent; the same
# tarballs the vcxproj build unpacks into agents/wnx/extlibs.
vendored_archive = use_repo_rule("//bazel/rules:vendored_archive.bzl", "vendored_archive")

vendored_archive(
    name = "wnx_simpleini",
    src = "//third_party:simpleini/simpleini-2af65fc.tar.gz",
    build_file = "//third_party:simpleini/BUILD.simpleini.bazel",
)

vendored_archive(
    name = "wnx_fmt",
    src = "//third_party:fmt/fmt-11.1.4.tar.gz",
    build_file = "//third_party:fmt/BUILD.fmt.bazel",
    strip_prefix = "fmt-11.1.4",
)

vendored_archive(
    name = "wnx_yaml_cpp",
    src = "//third_party:yaml-cpp/yaml-cpp-0.8.0.tar.gz",
    build_file = "//third_party:yaml-cpp/BUILD.yaml-cpp.bazel",
    strip_prefix = "yaml-cpp-0.8.0",
)
