 lib/filter.js                         |  27 +++-
 lib/groovy-lint-fix.js                |  33 ++++-
 lib/rules/ConsecutiveBlankLines.js    |   7 +-
 lib/rules/IndentationClosingBraces.js |  34 +++--
 lib/rules/IndentationComments.js      |   9 +-
 lib/rules/NoTabCharacter.js           |   8 +-
 lib/utils.js                          | 200 ++++++++++++++++++++++++++
 8 files changed, 294 insertions(+), 30 deletions(-)

