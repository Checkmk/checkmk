diff --git a/lib/utils.js b/lib/utils.js
index e4ed5d3..63816e5 100755
--- a/lib/utils.js
+++ b/lib/utils.js
@@ -212,6 +212,204 @@ function getLastVariableRange(errLine, evaluatedVars, variable, errItem) {
     return getLastStringRange(errLine, varValue, errItem);
 }
 
+// String literals, the longest opening delimiter first. Only single and double quoted strings end with the line,
+// unless a backslash escapes the line end.
+const STRING_LITERALS = [
+    { open: '"""', close: '"""', escape: /\\.?/y, interpolated: true, multiLine: true },
+    { open: "'''", close: "'''", escape: /\\.?/y, interpolated: false, multiLine: true },
+    { open: "$/", close: "/$", escape: /\$[$/]/y, interpolated: true, multiLine: true },
+    { open: '"', close: '"', escape: /\\.?/y, interpolated: true, multiLine: false },
+    { open: "'", close: "'", escape: /\\.?/y, interpolated: false, multiLine: false },
+];
+const SLASHY_STRING = { open: "/", close: "/", escape: /\\\//y, interpolated: true, multiLine: true };
+// Keywords followed by an expression: a slash after them starts a slashy string, not a division
+const KEYWORDS_BEFORE_EXPRESSION = new Set(["assert", "case", "default", "else", "in", "return", "throw", "yield"]);
+const WORD = /[\p{L}\p{N}_$]+/uy;
+const OPENING_BRACKETS = new Map([
+    [")", "("],
+    ["]", "["],
+    ["}", "{"],
+]);
+
+// Check if the delimiter of a string literal at a position closes it. Like the Groovy lexer, a run of up to five
+// quotes ends a triple quoted string with its last three quotes, e.g. """say "hi""""
+function closesStringLiteral(line, pos, close) {
+    if (!line.startsWith(close, pos)) {
+        return false;
+    }
+    if (close !== '"""' && close !== "'''") {
+        return true;
+    }
+    const quote = close[0];
+    return !(line[pos + 3] === quote && (line[pos + 4] !== quote || line[pos + 5] !== quote));
+}
+
+// Scan source lines like the Groovy lexer does, and return for each line:
+// - startsInCode: false if the line starts inside a string literal or a /* */ comment spanning several lines
+//   (code in the ${} of a string is code)
+// - startsInString: true if the line starts inside a string literal
+// - stringRanges: the [start, end[ ranges of the line which are the content of string literals
+// - openingBraces, closingBraces: number of { and } in code, including the ones delimiting a ${}, but not the ones
+//   in strings and comments
+// - openBraceAnchors: for each opening brace of the line which is still open at its end, the line whose indentation
+//   the matching closing brace takes. That is the line itself, unless the line starts inside a string literal or a
+//   comment, like in """) {. Then it is the line where the statement around the brace starts.
+// This allows line based fixes to leave the content of multi-line strings like """...""" untouched
+function getLinesInfo(allLines, divisions = new Set()) {
+    // Innermost scope last: code, string or comment. Code scopes after the first one are ${} in strings
+    const scopes = [{ kind: "code", brackets: [], slashyAllowed: true, startLine: 0 }];
+    // The innermost scope at the start of each line, and the number of brackets open in it
+    const lineStarts = [];
+    const linesInfo = [];
+
+    // The last line which starts in the code of a scope outside of the brackets open in it, or the line where the
+    // scope starts
+    const statementStartLine = (scope, lineNb) => {
+        let startLine = lineNb;
+        while (startLine > scope.startLine && !(lineStarts[startLine].scope === scope && lineStarts[startLine].brackets <= scope.brackets.length)) {
+            startLine--;
+        }
+        return startLine;
+    };
+
+    for (let lineNb = 0; lineNb < allLines.length; lineNb++) {
+        const line = allLines[lineNb];
+        const lineStartScope = scopes[scopes.length - 1];
+        lineStarts.push({ scope: lineStartScope, brackets: lineStartScope.kind === "code" ? lineStartScope.brackets.length : 0 });
+        const lineInfo = {
+            startsInCode: lineStartScope.kind === "code",
+            startsInString: lineStartScope.kind === "string",
+            stringRanges: [],
+            openingBraces: 0,
+            closingBraces: 0,
+            openBraceAnchors: [],
+        };
+        // Where the content of the current string literal starts in the line, null outside of string literals
+        let stringStart = lineInfo.startsInString ? 0 : null;
+        let escapedLineEnd = false;
+        let pos = 0;
+        while (pos < line.length) {
+            const scope = scopes[scopes.length - 1];
+            if (scope.kind === "comment") {
+                if (line.startsWith("*/", pos)) {
+                    scopes.pop();
+                    pos += 2;
+                } else {
+                    pos++;
+                }
+                continue;
+            }
+            if (scope.kind === "string") {
+                scope.escape.lastIndex = pos;
+                const escape = scope.escape.exec(line);
+                if (escape) {
+                    escapedLineEnd = escape[0] === "\\";
+                    pos += escape[0].length;
+                } else if (scope.interpolated && line.startsWith("${", pos)) {
+                    lineInfo.stringRanges.push([stringStart, pos]);
+                    stringStart = null;
+                    scopes.push({ kind: "code", brackets: [], slashyAllowed: true, inString: true, startLine: lineNb });
+                    lineInfo.openingBraces++;
+                    lineInfo.openBraceAnchors.push(lineNb);
+                    pos += 2;
+                } else if (closesStringLiteral(line, pos, scope.close)) {
+                    lineInfo.stringRanges.push([stringStart, pos]);
+                    stringStart = null;
+                    scopes.pop();
+                    pos += scope.close.length;
+                } else {
+                    pos++;
+                }
+                continue;
+            }
+            // Code
+            const char = line[pos];
+            if (line.startsWith("//", pos)) {
+                break;
+            }
+            if (line.startsWith("/*", pos)) {
+                scopes.push({ kind: "comment", startLine: lineNb });
+                pos += 2;
+                continue;
+            }
+            const startsSlashyString = char === "/" && scope.slashyAllowed && !divisions.has(`${lineNb}:${pos}`);
+            const literal = STRING_LITERALS.find((literal) => line.startsWith(literal.open, pos)) || (startsSlashyString ? SLASHY_STRING : null);
+            if (literal) {
+                scopes.push({ kind: "string", ...literal, startLine: lineNb, startPos: pos });
+                scope.slashyAllowed = false;
+                pos += literal.open.length;
+                stringStart = pos;
+                continue;
+            }
+            WORD.lastIndex = pos;
+            const word = WORD.exec(line);
+            if (word) {
+                scope.slashyAllowed = KEYWORDS_BEFORE_EXPRESSION.has(word[0]);
+                pos += word[0].length;
+                continue;
+            }
+            if (/\s/.test(char)) {
+                pos++;
+                continue;
+            }
+            if (char === "{") {
+                lineInfo.openingBraces++;
+                const inLineStartScope = scope === lineStartScope || scope.startLine === lineNb;
+                lineInfo.openBraceAnchors.push(inLineStartScope ? lineNb : statementStartLine(scope, lineNb));
+            } else if (char === "}") {
+                lineInfo.closingBraces++;
+                lineInfo.openBraceAnchors.pop();
+                if (scope.inString && !scope.brackets.includes("{")) {
+                    // End of ${} in a string
+                    scopes.pop();
+                    pos++;
+                    stringStart = pos;
+                    continue;
+                }
+            }
+            if (char === "(" || char === "[" || char === "{") {
+                scope.brackets.push(char);
+            } else if (OPENING_BRACKETS.has(char)) {
+                // Drop brackets left open inside the closed ones, too
+                const openingBracketPos = scope.brackets.lastIndexOf(OPENING_BRACKETS.get(char));
+                if (openingBracketPos > -1) {
+                    scope.brackets.length = openingBracketPos;
+                }
+            }
+            // After an operand, a slash is a division, otherwise it starts a slashy string
+            const postfixOperator = line.startsWith("++", pos) || line.startsWith("--", pos);
+            scope.slashyAllowed = !postfixOperator && !OPENING_BRACKETS.has(char);
+            pos += postfixOperator ? 2 : 1;
+        }
+        if (stringStart !== null) {
+            lineInfo.stringRanges.push([stringStart, line.length]);
+        }
+        // Recover from single and double quoted strings which are not terminated on their line
+        while (!escapedLineEnd && scopes[scopes.length - 1].kind === "string" && !scopes[scopes.length - 1].multiLine) {
+            scopes.pop();
+        }
+        // Outside of parentheses and brackets a new line ends the statement, so a slash at the start of the next line
+        // starts a slashy string
+        const lineEndScope = scopes[scopes.length - 1];
+        if (lineEndScope.kind === "code" && !["(", "["].includes(lineEndScope.brackets[lineEndScope.brackets.length - 1])) {
+            lineEndScope.slashyAllowed = true;
+        }
