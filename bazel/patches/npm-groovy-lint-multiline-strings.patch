diff --git a/lib/filter.js b/lib/filter.js
index b2c0023..bd3b741 100755
--- a/lib/filter.js
+++ b/lib/filter.js
@@ -1,5 +1,25 @@
 // Filter errors
 
+import { isInStringLiteral } from "./utils.js";
+
+// CodeNarc checks these rules line by line, so it reports whitespace in string literals, too. Fixing it would change
+// the values of the strings, so such violations are ignored. CodeNarc reports only the first tab of a file, so its
+// violation is ignored only if there is no tab outside of string literals at all.
+const STRING_CONTENT_VIOLATIONS = {
+    ConsecutiveBlankLines: (allLines, linesInfo, linePos) => linesInfo[linePos].startsInString,
+    NoTabCharacter: (allLines, linesInfo) => allLines.every((line, lineNb) => hasTabsOnlyInStringLiterals(line, linesInfo[lineNb])),
+    TrailingWhitespace: (allLines, linesInfo, linePos) => isInStringLiteral(linesInfo[linePos], allLines[linePos].length - 1),
+};
+
+function hasTabsOnlyInStringLiterals(line, lineInfo) {
+    for (let pos = line.indexOf("\t"); pos > -1; pos = line.indexOf("\t", pos + 1)) {
+        if (!isInStringLiteral(lineInfo, pos)) {
+            return false;
+        }
+    }
+    return true;
+}
+
 // Parse source to list parts where errors must be ignored
 function collectDisabledBlocks(allLines) {
     const disabledBlocks = [];
@@ -36,7 +56,7 @@ function collectDisabledBlocks(allLines) {
     });
 }
 // Check if an error returned by CodeNarc should be filtered by npm-groovy-lint according to comments instructions
-function isFilteredError(errItem, allLines, disabledBlocks) {
+function isFilteredError(errItem, allLines, disabledBlocks, linesInfo) {
     const linePos = errItem.line - 1;
     const line = allLines[linePos] || "";
     const ruleName = errItem.rule;
@@ -58,6 +78,11 @@ function isFilteredError(errItem, allLines, disabledBlocks) {
     if (checkMatch(lineConfigNextLine, ruleName)) {
         return true;
     }
+    // whitespace in the content of string literals
+    const isStringContent = STRING_CONTENT_VIOLATIONS[ruleName];
+    if (isStringContent && linePos >= 0 && linePos < allLines.length && isStringContent(allLines, linesInfo, linePos)) {
+        return true;
+    }
 
     return false;
 }
