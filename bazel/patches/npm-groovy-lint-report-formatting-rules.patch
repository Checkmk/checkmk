diff --git a/lib/groovy-lint-fix.js b/lib/groovy-lint-fix.js
index 3f84701..a4158d4 100644
--- a/lib/groovy-lint-fix.js
+++ b/lib/groovy-lint-fix.js
@@ -21,6 +21,34 @@ function replaceLine(allLines, lineNb, newLine) {
     return newLines;
 }
 
+// The changes of the formatting rules to always run, applied like fixErrors() applies them when there is nothing else
+// to fix: one { ruleName, line } per line which a rule changes, line numbers starting at 1
+export async function getFormattingRulesToAlwaysRunChanges(allLines) {
+    const npmGroovyLintRules = await getNpmGroovyLintRules();
+    const stringLiterals = getStringLiterals(allLines);
+    const ruleNames = [...getFormattingRulesToAlwaysRun()].sort((a, b) => npmGroovyLintRules[a].priority - npmGroovyLintRules[b].priority);
+    const changes = [];
+    for (const ruleName of ruleNames) {
+        let allLinesNew;
+        try {
+            allLinesNew = npmGroovyLintRules[ruleName].fix.func([...allLines]);
+        } catch (e) {
+            debug(e.message);
+            continue;
+        }
+        if (getStringLiterals(allLinesNew) !== stringLiterals) {
+            continue;
+        }
+        for (let lineNb = 0; lineNb < Math.max(allLines.length, allLinesNew.length); lineNb++) {
+            if (allLinesNew[lineNb] !== allLines[lineNb]) {
+                changes.push({ ruleName, line: lineNb + 1 });
+            }
+        }
+        allLines = allLinesNew;
+    }
+    return changes;
+}
+
 export class NpmGroovyLintFix {
     options = {};
 
