+// Check if a rule is enabled in the configuration
+function isEnabledRule(ruleFromConfig) {
+    return ruleFromConfig != null && !(ruleFromConfig === "off" || ruleFromConfig.disabled === true || ruleFromConfig.enabled === false);
+}
+
+// Violations like the ones returned by CodeNarc for the lines which the formatting rules to always run would change.
+// These rules exist only in npm-groovy-lint, and are reported if they are enabled in the configuration (as info by default)
+async function getFormattingRulesToAlwaysRunViolations(allLines, rules = {}) {
+    if (!getFormattingRulesToAlwaysRun().some((ruleName) => isEnabledRule(rules[ruleName]))) {
+        return [];
+    }
+    const npmGroovyLintRules = await getNpmGroovyLintRules();
+    const changes = await getFormattingRulesToAlwaysRunChanges(allLines);
+    return changes
+        .filter((change) => isEnabledRule(rules[change.ruleName]))
+        .map((change) => ({
+            lineNumber: change.line,
+            ruleName: change.ruleName,
+            priority: getCodeNarcPriorityCode(rules[change.ruleName]) || 3,
+            message: npmGroovyLintRules[change.ruleName].message,
+        }));
+}
