+# Prints those of the files listed on stdin, one per line, whose first line
+# matches the extended regular expression $1. A single awk process reads them
+# all, instead of one `head | grep` pipeline per file.
+function first-line-matches {
+    local file
+    while IFS= read -r file; do
+        if [ -f "$file" ]; then
+            echo "$file"
+        fi
+    done | awk -v re="$1" '(getline line < $0) > 0 && line ~ re { print } { close($0) }'
+}
