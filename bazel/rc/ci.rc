# Flags for CI builds, used via "--config=ci" from /etc/ci.bazelrc

common:ci --test_summary=terse

common:ci --color=no
common:ci --show_progress_rate_limit=0
common:ci --show_timestamps
common:ci --memory_profile=bazel-memory.profile
common:ci --generate_json_trace_profile
common:ci --profile=trace_profile.json
common:ci --//bazel/toolchains/cc/gcc/local:gcc_path=opt

# rules_python builds sdist-only packages with pip, whose build isolation fetches setuptools
# from pypi.org. Offer the internal Nexus proxy as a second index.
common:ci --repo_env=PIP_EXTRA_INDEX_URL=https://artifacts.lan.tribe29.com/repository/pypi-proxy/simple

# Build the OMD python3-modules from sdists downloaded through the Nexus PyPI proxy, see
# //:pip_index_url.
common:ci --//:pip_index_url=https://artifacts.lan.tribe29.com/repository/pypi-proxy/simple

# rules_python links the hermetic Python's stdlib __pycache__ dirs to a root it creates when it
# fetches the toolchain. CI keeps the toolchain in the node's shared repo contents cache (see
# /etc/ci.bazelrc), so the root must live on that mount, too, or the links dangle in other jobs.
common:ci --repo_env=RULES_PYTHON_PYCACHE_DIR=/tmp/shared_repository_cache/rules_python_pycache

# the onwards set jobs and CPU limits shall be aligned with the k8s pod limits
common:ci --jobs=6
common:ci --loading_phase_threads=4
common:ci --local_resources=cpu=6
common:ci --worker_max_instances=6
common:ci --local_resources=memory=HOST_RAM*.67
# Enables the experimental local execution scheduling based on CPU load, not estimation of actions one by one.
common:ci --experimental_cpu_load_scheduling

# Undo performance.rc: CI containers only have Docker's default 64 MB /dev/shm
common:ci --sandbox_base=

# upload artifacts only from CI, CMK-18656
common:ci --remote_upload_local_results=true

# Don't create runfiles symlink trees for every built target, only on demand for tests and
# "bazel run". With cached test results these trees are pure overhead: ~45s per CV unit test run.
# Executing bazel-bin/<binary> directly after "bazel build" needs "bazel run" instead.
common:ci --nobuild_runfile_links

common:ci --@cmk//distro=UNSET

# Ship optimized, stripped binaries from CI.
# Scoped per-target via select() so only the shipped binaries are affected
# See bazel/cmk/optimize and bazel/cmk/strip.
common:ci --@cmk//optimize=True
common:ci --@cmk//strip=True

common:ci --noshow_progress
