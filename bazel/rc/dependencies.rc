# Fetching external dependencies: registries, download mirrors and Bzlmod

# Use local registry to add local download mirrors
common --registry="file:///%workspace%/bazel/thirdparty"
common --registry=https://bcr.bazel.build

# Add mirrors for certain download URLs
common --downloader_config=bazel_downloader.cfg

# WORKSPACE support is fully removed; everything is defined via Bzlmod (MODULE.bazel)
common --noenable_workspace

# Enable Bzlmod for every Bazel command
common --enable_bzlmod

# The Aspect rulesets pull in aspect_tools_telemetry, which POSTs a report about
# our module graph, OS and CI environment to telemetry.aspect.build from a repo
# rule.  Its one-time opt-out notice is suppressed as soon as MODULE.bazel.lock
# records that somebody has seen it, so opt out explicitly instead.  Note that
# our lockfile carries that notice_version fact, so upstream can no longer
# re-prompt when it widens what it collects: this flag is the only gate, and it
# only applies to invocations which actually read this file.
common --repo_env=DO_NOT_TRACK=1

# Try with our proxy first and fall back to public proxy when fetching go modules.
common --repo_env=GOPROXY="https://bazel-registry.lan.checkmk.net/proxy.golang.org/|https://proxy.golang.org|direct"

# Configure gazelle to use the ~/go/pkg/mod folder for downloaded artifacts.
common --repo_env=GO_REPOSITORY_USE_HOST_MODCACHE=1
