load("@@//bazel/rules:dependency_info.bzl", "dependency_info")
load("@@//bazel/rules:patchelf.bzl", "set_runpath")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

dependency_info(
    name = "dependency_info",
    package_name = "msitools",
    license_kind = "@package_metadata//licenses/spdx:GPL-2.0-only",
    license_text = "COPYING",
    purl_namespace = None,
    purl_type = "generic",
    version = module_version(),
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["**/*"],
    ),
    package_metadata = [":dependency_info"],
    tags = ["manual"],
)

configure_make(
    name = "msitools",
    args = ["-j4"],
    copts = [
        "-Wno-cast-align",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-sometimes-uninitialized",
        "-Wno-unknown-warning",
        "-Wno-unused-but-set-variable",
    ],
    env = {
        "PKG_CONFIG_PATH": ":".join([
            "/usr/lib/pkgconfig",
            "/usr/lib64/pkgconfig",
            "/usr/lib/x86_64-linux-gnu/pkgconfig",
        ]),
    } | select(
        {
            "@cmk//distro:sles": {
                "GSF_LIBS": "-L$${EXT_BUILD_DEPS}/libgsf/lib -lgsf-1",
                "GSF_CFLAGS": "-I$${EXT_BUILD_DEPS}/libgsf/include/libgsf-1",
            },
            "//conditions:default": {},
        },
    ),
    lib_name = "msitools",
    lib_source = ":srcs",
    out_binaries = [
        "msiinfo",
        "msibuild",
    ],
    out_shared_libs = [
        "libmsi.so.0.0.0",
    ],
    postfix_script = """
        mkdir -p $${INSTALLDIR}/{bin,lib}/
        install -m 755 $${BUILD_TMPDIR}/.libs/msiinfo $${INSTALLDIR}/bin/
        install -m 755 $${BUILD_TMPDIR}/.libs/msibuild $${INSTALLDIR}/bin/
        install -m 755 $${BUILD_TMPDIR}/libmsi/.libs/libmsi.so.0.0.0 $${INSTALLDIR}/lib
    """,
    set_file_prefix_map = True,
    tags = ["manual"],
    targets = [
        "-C libmsi",
        "msibuild",
        "msiinfo",
    ],
    visibility = ["//visibility:public"],
    deps = select(
        {
            "@cmk//distro:sles": ["@libgsf"],
            "//conditions:default": [],
        },
    ),
)

filegroup(
    name = "msibuild_fg",
    srcs = [":msitools"],
    output_group = "msibuild",
    tags = ["manual"],
)

filegroup(
    name = "msiinfo_fg",
    srcs = [":msitools"],
    output_group = "msiinfo",
    tags = ["manual"],
)

filegroup(
    name = "libmsi_so_fg",
    srcs = [":msitools"],
    output_group = "libmsi.so.0.0.0",
)

set_runpath(
    name = "msibuild_runpath",
    srcs = [":msibuild_fg"],
    rpaths = ["${ORIGIN}/../lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

set_runpath(
    name = "msiinfo_runpath",
    srcs = [":msiinfo_fg"],
    rpaths = ["${ORIGIN}/../lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

set_runpath(
    name = "lib",
    srcs = [":libmsi_so_fg"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

copy_file(
    name = "libmsi_so_symlink_fs",
    src = ":lib",
    out = "lib/libmsi.so.0",  # SONAME
    allow_symlink = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "msibuild_runpath_fg",
    srcs = [":msibuild_runpath"],
)

filegroup(
    name = "msiinfo_runpath_fg",
    srcs = [":msiinfo_runpath"],
)

native_binary(
    name = "msibuild",
    src = ":msibuild_runpath_fg",
    data = [
        ":lib",
        ":libmsi_so_symlink_fs",
    ],
    visibility = ["//visibility:public"],
)

native_binary(
    name = "msiinfo",
    src = ":msiinfo_runpath_fg",
    data = [
        ":lib",
        ":libmsi_so_symlink_fs",
    ],
    visibility = ["//visibility:public"],
)
