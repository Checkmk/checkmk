load("@@//bazel/rules:dependency_info.bzl", "dependency_info")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load(":perl_bindings.bzl", "rrdtool_perl_bindings")

package(default_package_metadata = [":dependency_info"])

dependency_info(
    name = "dependency_info",
    package_name = "rrdtool",
    cpe_format_str = "cpe:2.3:a:rrdtool_project:rrdtool:%s:*:*:*:*:*:*:*",
    license_kind = "@package_metadata//licenses/spdx:GPL-2.0-only",
    license_text = "COPYRIGHT",
    purl_namespace = None,
    purl_type = "generic",
    version = module_version(),
)

# port from upstream `src/Makefile.am`

NUMVERS = "1.7002"

cc_library(
    name = "rrd_config",
    hdrs = ["src/rrd_config.h"],
    includes = ["src"],
)

cc_library(
    name = "rrdupd",
    srcs = [
        "src/mutex.c",
        "src/optparse.c",
        "src/rrd_strtod.c",
        "src/rrd_create.c",
        "src/hash_32.c",
        "src/rrd_parsetime.c",
        "src/rrd_hw.c",
        "src/rrd_hw_math.c",
        "src/rrd_hw_update.c",
        "src/rrd_diff.c",
        "src/rrd_format.c",
        "src/rrd_info.c",
        "src/rrd_error.c",
        "src/rrd_open.c",
        "src/rrd_client.c",
        "src/rrd_nan_inf.c",
        "src/rrd_rpncalc.c",
        "src/rrd_utils.c",
        "src/rrd_snprintf.c",
        "src/rrd_restore.c",
        "src/rrd_update.c",
        "src/rrd_modify.c",
        "src/quicksort.c",
        "src/rrd_thread_safe.c",
        # private headers
        "src/unused.h",
        "src/gettext.h",
        "src/mutex.h",
        "src/rrd_strtod.h",
        "src/rrd_snprintf.h",
        "src/rrd_parsetime.h",
        "src/rrd_config_bottom.h",
        "src/rrd_i18n.h",
        "src/rrd_format.h",
        "src/rrd_tool.h",
        "src/rrd_xport.h",
        "src/optparse.h",
        "src/rrd.h",
        "src/rrd_rpncalc.h",
        "src/rrd_hw.h",
        "src/rrd_hw_math.h",
        "src/rrd_hw_update.h",
        "src/rrd_restore.h",
        "src/rrd_create.h",
        "src/fnv.h",
        "src/rrd_graph.h",
        "src/rrd_is_thread_safe.h",
        "src/rrd_modify.h",
        "src/rrd_update.h",
        "src/quicksort.h",
    ],
    hdrs = [
        "src/rrd.h",
        "src/rrd_client.h",
        "src/rrd_format.h",
    ],
    copts = [
        # src/rrd_restore.c assigns xmlGetLastError() to a non-const xmlErrorPtr; libxml2 made the
        # return const in 2.12.  Harmless -- rrdtool only reads the struct.
        "-Wno-discarded-qualifiers",
        "-Wno-int-conversion",
        "-Wno-stringop-overflow",
        "-Wno-stringop-truncation",
        "-Wno-unknown-warning",
        "-Wno-unused-but-set-variable",
        "-O2",
    ],
    deps = [
        ":rrd_config",
        "@glib//glib",
        "@libxml2",
    ],
)

cc_library(
    name = "rrd_library",
    srcs = [
        "src/rrd_dump.c",
        "src/rrd_fetch.c",
        "src/rrd_fetch_cb.c",
        "src/rrd_first.c",
        "src/rrd_flushcached.c",
        "src/rrd_last.c",
        "src/rrd_lastupdate.c",
        "src/rrd_list.c",
        "src/rrd_resize.c",
        "src/rrd_tune.c",
        "src/rrd_version.c",
    ],
    copts = [
        "-std=gnu99",
        "-Wno-format-truncation",  # false positive in src/rrd_list.c
        "-O2",  # maybe O3?
    ],
    local_defines = [
        'NUMVERS="' + NUMVERS + '"',
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":rrdupd",
    ],
)

# libbdi
# librados

# The graph subsystem is disabled (see patches 0006/0007), which drops Cairo,
# Pango, gobject and libpng.  These four files still carry the data engine that
# xport is built on (data_fetch, data_calc, print_calc, vdef_*,
# rrd_graph_script), so they stay; only their drawing half is compiled out.
# src/pngsize.c is reachable only from lazy_check() and is therefore dropped.
cc_library(
    name = "rrdxport",
    srcs = [
        "src/rrd_gfx.c",
        "src/rrd_graph.c",
        "src/rrd_graph_helper.c",
        "src/rrd_xport.c",
    ],
    copts = [
        "-Wno-format-truncation",
        "-Wno-implicit-function-declaration",
        "-Wno-strict-aliasing",
        "-Wno-stringop-overflow",
        "-Wno-unknown-warning",
        "-Wno-unused-but-set-variable",
        "-O2",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":rrd_library",
        "@glib//glib",
    ],
)

cc_binary(
    name = "rrdupdate",
    srcs = ["src/rrdupdate.c"],
    copts = [
        "-O2",
    ],
    features = ["strip_debug"],
    linkopts = [
        "-lpthread",
    ],
    visibility = ["//visibility:public"],
    deps = [":rrdupd"],
)

cc_binary(
    name = "rrdtool",
    srcs = ["src/rrd_tool.c"],
    copts = [
        "-Wno-implicit-function-declaration",
        "-Wno-format-truncation",
        "-O2",
    ],
    features = ["strip_debug"],
    linkopts = [
        "-lpthread",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "rrdxport",
    ],
)

cc_binary(
    name = "rrdcached",
    srcs = ["src/rrd_daemon.c"],
    copts = [
        "-Wno-format-truncation",
        "-O2",
    ],
    features = ["strip_debug"],
    linkopts = [
        "-lpthread",
    ],
    local_defines = ["LOCALSTATEDIR="],
    visibility = ["//visibility:public"],
    deps = [
        ":rrd_library",
        ":rrdupd",
        "@glib//glib",
    ],
)

cc_shared_library(
    name = "rrd_shared",
    shared_lib_name = "librrd.so",
    # glib, libxml2 and pcre2 come in as static archives from the BCR modules.  Hide their
    # symbols so they are not re-exported from this shared library and cannot interpose on a
    # system copy loaded into the same process.  NOT --exclude-libs=ALL: rrdtool's own code is
    # in archives too, and ALL would hide the rrd_* API we exist to export.
    # (colon-separated: gcc splits -Wl, on commas, so a comma list would make ld treat the rest
    # as input files)
    user_link_flags = ["-Wl,--exclude-libs,libglib.a:libxml2.a:libpcre2.a"],
    visibility = ["@@//omd/packages/rrdtool:__pkg__"],
    deps = [
        "rrd_library",
        "rrdupd",
        "rrdxport",
    ],
)

cc_library(
    name = "rrdtoolmodule",
    srcs = [
        "bindings/python/rrdtoolmodule.c",
    ],
    copts = [
        "-Wno-discarded-qualifiers",
        "-Wno-ignored-qualifiers",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-unknown-warning",
        "-O2",
    ],
    features = ["strip_debug"],
    deps = [
        ":rrd_config",
        ":rrdxport",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
    alwayslink = True,
)

cc_shared_library(
    name = "rrdtoolmodule_shared",
    shared_lib_name = "rrdtool.so",
    # glib, libxml2 and pcre2 come in as static archives from the BCR modules.  Hide their
    # symbols so they are not re-exported from this shared library and cannot interpose on a
    # system copy loaded into the same process.  NOT --exclude-libs=ALL: rrdtool's own code is
    # in archives too, and ALL would hide the rrd_* API we exist to export.
    # (colon-separated: gcc splits -Wl, on commas, so a comma list would make ld treat the rest
    # as input files)
    user_link_flags = ["-Wl,--exclude-libs,libglib.a:libxml2.a:libpcre2.a"],
    deps = [":rrdtoolmodule"],
)

py_library(
    name = "rrdtool_python_lib",
    data = [":rrdtoolmodule_shared"],
    visibility = ["//visibility:public"],
)

py_wheel(
    name = "rrdtool_python_wheel",
    distribution = "rrdtool",
    version = "1",
    visibility = ["//visibility:public"],
    deps = [":rrdtoolmodule_shared"],
)

# Perl bindings, ported from upstream `bindings/Makefile.am`.
rrdtool_perl_bindings(
    name = "perl_bindings_gen_dir",
    distro = select(
        {
            "@cmk//distro:almalinux-8": "almalinux-8",
            "@cmk//distro:almalinux-9": "almalinux-9",
            "@cmk//distro:almalinux-10": "almalinux-10",
            "@cmk//distro:debian-12": "debian-12",
            "@cmk//distro:debian-13": "debian-13",
            "@cmk//distro:sles-15sp7": "sles-15sp7",
            "@cmk//distro:sles-16.0": "sles-16.0",
            "@cmk//distro:ubuntu-22.04": "ubuntu-22.04",
            "@cmk//distro:ubuntu-24.04": "ubuntu-24.04",
            "@cmk//distro:ubuntu-26.04": "ubuntu-26.04",
        },
        no_match_error = "rrdtool's Perl bindings are built against the host perl, whose " +
                         "archname and XS ABI differ per distro.  Build with --@cmk//distro=<distro>.",
    ),
    librrd = ":rrd_shared",
    # RRDp (perl-piped) has no known consumer: pnp4nagios uses only RRDs, and Checkmk itself
    # ships no Perl that touches RRD.  It is built and shipped to keep the package contents
    # unchanged, not because anything needs it.
    perl_piped_srcs = [
        "bindings/perl-piped/Makefile.PL",
        "bindings/perl-piped/RRDp.pm",
    ],
    perl_shared_srcs = [
        "bindings/perl-shared/Makefile.PL",
        "bindings/perl-shared/RRDs.pm",
        "bindings/perl-shared/RRDs.xs",
    ],
    rrd_headers = glob(["src/*.h"]),
    visibility = ["//visibility:public"],
)
