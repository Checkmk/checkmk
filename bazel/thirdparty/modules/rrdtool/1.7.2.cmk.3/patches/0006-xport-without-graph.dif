     PangoLayout *layout; /* the pango layout we use for writing fonts */
+#else
+    /* unused without Cairo/Pango, but kept so the struct layout does not
+       depend on the build configuration */
+    void     *surface;
+    void     *cr;
+    void     *font_options;
+    int       graph_antialias;
+    void     *layout;
+#endif
     rrd_info_t *grinfo; /* root pointer to extra graph info */
     rrd_info_t *grinfo_current; /* pointing to current entry */
     GHashTable* gdef_map;  /* a map of all *def gdef entries for quick access */
@@ -566,6 +582,8 @@ void      gfx_close_path(
     image_desc_t *im);
 
 
+#ifdef HAVE_RRD_GRAPH
+
 /* create a text node */
 void      gfx_text(
     image_desc_t *im,
@@ -595,6 +613,8 @@ double    gfx_get_text_height(
     double tabwidth,
