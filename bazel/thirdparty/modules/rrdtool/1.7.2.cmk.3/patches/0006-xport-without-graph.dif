Build xport without the graph subsystem.

rrd_xport.c is implemented on top of the graph engine, so upstream ties
it to --disable-rrd_graph and thus to Cairo/Pango.  Guard only the
drawing half with HAVE_RRD_GRAPH and keep the data engine (data_fetch,
data_calc, print_calc, vdef_*, rrd_graph_script) unconditional, so that
xport survives a build without Cairo/Pango.  See also
0007-config-disable_rrd_graph.dif, which turns HAVE_RRD_GRAPH off.

diff --git a/bindings/python/rrdtoolmodule.c b/bindings/python/rrdtoolmodule.c
index 248afd41..6dbce993 100644
--- a/bindings/python/rrdtoolmodule.c
+++ b/bindings/python/rrdtoolmodule.c
@@ -673,6 +673,8 @@ _rrdtool_graphv(PyObject *Py_UNUSED(self), PyObject *args)
     return ret;
 }
 
+#endif /* HAVE_RRD_GRAPH */
+
 static char _rrdtool_xport__doc__[] = "Dictionary representation of data " \
   "stored in RRDs.\n\n\
   Usage: xport(args..)\n\
@@ -779,8 +781,6 @@ _rrdtool_xport(PyObject *Py_UNUSED(self), PyObject *args)
     return ret;
 }
 
-#endif /* HAVE_RRD_GRAPH */
-
 static char _rrdtool_list__doc__[] = "List RRDs in storage.\n\n" \
   "Usage: list(args..)\n\
   Arguments:\n\n\
@@ -1411,9 +1411,9 @@ static PyMethodDef rrdtool_methods[] = {
      METH_VARARGS, _rrdtool_graph__doc__},
     {"graphv", (PyCFunction)_rrdtool_graphv,
      METH_VARARGS, _rrdtool_graphv__doc__},
+#endif
     {"xport", (PyCFunction)_rrdtool_xport,
      METH_VARARGS, _rrdtool_xport__doc__},
-#endif
     {"list", (PyCFunction)_rrdtool_list,
      METH_VARARGS, _rrdtool_list__doc__},
     {"tune", (PyCFunction)_rrdtool_tune,
