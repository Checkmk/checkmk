# The actual process management lives in cmk-maps-server (Python): lintable,
# type-checked and unit-testable, unlike bash. This wrapper only gates on the
# CONFIG_MAPS on/off hook and forwards the command.

# shellcheck disable=SC1090,SC1091
. "$OMD_ROOT/etc/omd/site.conf"
if [ "$CONFIG_MAPS" != on ]; then
    exit 5
fi

case "$1" in
    start | stop | restart | reload | logrotate | status)
        exec cmk-maps-server "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|logrotate|status}"
        exit 1
        ;;
esac
