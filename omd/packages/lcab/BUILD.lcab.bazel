load("@@//bazel/rules:xcomp/foreign_cc.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*"],
        exclude = ["bazel-*"],
    ),
)

configure_make(
    name = "lcab",
    args = ["-j4"],
    env = {
        "DESTDIR": "/",
        "PKG_CONFIG_PATH": ":".join([
            "/usr/lib/pkgconfig",
            "/usr/lib64/pkgconfig",
            "/usr/lib/x86_64-linux-gnu/pkgconfig",
        ]),
    },
    install_prefix = "lcab_dir",
    lib_source = ":all_srcs",
    linkopts = ["-Wl,--strip-all"],
    out_bin_dir = "bin",
    out_binaries = [
        "lcab",
    ],
    out_shared_libs = [
    ],
    platform = "@@//bazel/platforms:x86_64-linux-gcc-hermetic",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lcab_bin",
    srcs = [":lcab"],
    output_group = "lcab",
    visibility = ["//visibility:public"],
)
