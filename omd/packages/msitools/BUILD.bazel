load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/rules:patchelf.bzl", "set_runpath")

filegroup(
    name = "msibuild_fg",
    srcs = ["@msitools"],
    output_group = "msibuild",
    tags = ["manual"],
)

filegroup(
    name = "msiinfo_fg",
    srcs = ["@msitools"],
    output_group = "msiinfo",
    tags = ["manual"],
)

filegroup(
    name = "libmsi_so_fg",
    srcs = ["@msitools"],
    output_group = "libmsi.so.0.0.0",
)

set_runpath(
    name = "msibuild_runpath",
    srcs = [":msibuild_fg"],
    rpaths = ["${ORIGIN}/../lib"],
    tags = ["manual"],
)

set_runpath(
    name = "msiinfo_runpath",
    srcs = [":msiinfo_fg"],
    rpaths = ["${ORIGIN}/../lib"],
    tags = ["manual"],
)

set_runpath(
    name = "lib",
    srcs = [":libmsi_so_fg"],
    tags = ["manual"],
)

copy_file(
    name = "libmsi_so_symlink_fs",
    src = ":lib",
    out = "lib/libmsi.so.0",  # SONAME
    allow_symlink = True,
    tags = ["manual"],
)

filegroup(
    name = "msibuild_runpath_fg",
    srcs = [":msibuild_runpath"],
)

filegroup(
    name = "msiinfo_runpath_fg",
    srcs = [":msiinfo_runpath"],
)

native_binary(
    name = "msibuild",
    src = ":msibuild_runpath_fg",
    data = [
        ":lib",
        ":libmsi_so_symlink_fs",
    ],
    visibility = ["//visibility:public"],
)

native_binary(
    name = "msiinfo",
    src = ":msiinfo_runpath_fg",
    data = [
        ":lib",
        ":libmsi_so_symlink_fs",
    ],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "bin",
    srcs = [
        ":msibuild_runpath",
        ":msiinfo_runpath",
    ],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "bin",
    tags = ["manual"],
)

pkg_files(
    name = "libmsi_so",
    srcs = [":lib"],
)

pkg_mklink(
    name = "libmsi_so_major_symlink",
    link_name = "libmsi.so.0",
    tags = ["manual"],
    target = "libmsi.so.0.0.0",
)

pkg_mklink(
    name = "libmsi_so_symlink",
    link_name = "libmsi.so",
    tags = ["manual"],
    target = "libmsi.so.0",
)

pkg_filegroup(
    name = "lib_pkg",
    srcs = [
        ":libmsi_so",
        ":libmsi_so_major_symlink",
        ":libmsi_so_symlink",
    ],
    prefix = "lib",
    tags = ["manual"],
)

pkg_tar(
    name = "msitools",
    srcs = [
        ":bin",
        ":lib_pkg",
    ],
    stamp = 1,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
