load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_files(
    name = "bin",
    srcs = [
        "@msitools//:msibuild_runpath",
        "@msitools//:msiinfo_runpath",
    ],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "bin",
    tags = ["manual"],
)

pkg_files(
    name = "libmsi_so",
    srcs = ["@msitools//:lib"],
)

pkg_mklink(
    name = "libmsi_so_major_symlink",
    link_name = "libmsi.so.0",
    tags = ["manual"],
    target = "libmsi.so.0.0.0",
)

pkg_mklink(
    name = "libmsi_so_symlink",
    link_name = "libmsi.so",
    tags = ["manual"],
    target = "libmsi.so.0",
)

pkg_filegroup(
    name = "lib_pkg",
    srcs = [
        ":libmsi_so",
        ":libmsi_so_major_symlink",
        ":libmsi_so_symlink",
    ],
    prefix = "lib",
    tags = ["manual"],
)

pkg_tar(
    name = "msitools",
    srcs = [
        ":bin",
        ":lib_pkg",
    ],
    stamp = 1,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
