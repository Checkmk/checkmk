load("@@//bazel/rules:dependency_info.bzl", "dependency_info")
load("@@//bazel/rules:xcomp/foreign_cc.bzl", "make")

dependency_info(
    name = "dependency_info",
    package_name = "snap7",
    cpe_format_str = "cpe:2.3:a:snap7_project:snap7:%s:*:*:*:*:*:*:*",
    license_kind = "@package_metadata//licenses/spdx:LGPL-3.0-only",
    purl_namespace = None,
    purl_type = "generic",
    version = "1.4.2",
)

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [
            "bazel-*",
            "Makefile",
        ],
    ),
    package_metadata = [":dependency_info"],
)

make(
    name = "snap7",
    args = [
        "-j4",
        "-C build/unix -f x86_64_linux.mk",
        "LibInstall=$INSTALLDIR",
        # build/unix/common.mk and x86_64_linux.mk (vendored) hard-assign
        # CXX/CXXFLAGS/SharedObjectLinkerName with Makefile ':=', beating
        # rules_foreign_cc's exported environment variables. -e restores
        # environment precedence for CXX/CXXFLAGS, but not for
        # SharedObjectLinkerName, which is overridden directly via make's
        # $(CXX), single-quoted so the shell doesn't run it as a command
        # substitution.
        "-e",
        "SharedObjectLinkerName='$(CXX) -shared -fPIC'",
    ],
    lib_source = ":all_srcs",
    linkopts = ["-Wl,--strip-all"],
    out_lib_dir = "",
    out_shared_libs = [
        "libsnap7.so",
    ],
    platform = "@@//bazel/platforms:x86_64-linux-gcc-hermetic",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "libsnap7.so",
    srcs = [":snap7"],
    output_group = "libsnap7.so",
    visibility = ["//visibility:public"],
)
