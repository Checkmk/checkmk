set -e

SITE=${SITE:-$(until [ "${PWD}" = / ]; do if [ -e .site ]; then
    cat .site
    break
else cd ..; fi; done)}
SITE=${SITE:-$(omd sites --bare | head -n 1)}
ROOT=/omd/sites/$SITE
test -d "${ROOT}" || exit 1

bazel build ":wheel"

# pip installs the package in the user directory in case of missing permissions
# this might be surprising and hard to spot, so we force the global installation
# hint: use `omd-setup-version-for-dev` to fix permissions of the checkmk site.
export PYTHONNOUSERSITE=1

"${ROOT}/bin/python3" -m pip install \
    --no-deps \
    --upgrade \
    --force-reinstall \
    --isolated \
    --disable-pip-version-check \
    "$(bazel info workspace)/$(bazel cquery :wheel --output=starlark --starlark:expr="target.files.to_list()[0].path")"

# The C++ helpers are not part of the wheel, so install them separately.
# mkeventd_open514 binds port 514 and therefore needs the capability.
bazel build ":mkevent" ":mkeventd_open514"
sudo install -m 0755 \
    "$(bazel info workspace)/$(bazel cquery --output=files :mkevent)" \
    "${ROOT}/bin/mkevent"
sudo install -m 0750 -o root -g omd \
    "$(bazel info workspace)/$(bazel cquery --output=files :mkeventd_open514)" \
    "${ROOT}/bin/mkeventd_open514"
sudo setcap "CAP_NET_BIND_SERVICE+ep" "${ROOT}/bin/mkeventd_open514"

if [ -z "${ONLY_COPY}" ]; then
    sudo --login -u "${SITE}" -- bash -c "omd restart mkeventd"
fi
