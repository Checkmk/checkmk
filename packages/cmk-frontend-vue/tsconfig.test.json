{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "weaki18nString.d.ts", "src/**/*", "tests/**/*.ts", "tests/**/*.vue"],
  "exclude": ["src/lib/i18nString.ts"],
  "compilerOptions": {
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/lib/i18nString": ["weaki18nString.d.ts"],
      "@/*": ["./src/*"],
      "@demo/*": ["./demo/*"],
      "@tests/*": ["./tests/*"],
      // openapi-msw only declares its types in "exports", which "node" resolution does not read
      "openapi-msw": [
        "./node_modules/openapi-msw/dist/exports/main.d.ts",
        "../../bazel-bin/packages/cmk-frontend-vue/node_modules/openapi-msw/dist/exports/main.d.ts"
      ],
      "*": ["./node_modules/*", "../../bazel-bin/packages/cmk-frontend-vue/node_modules/*"]
    }
  }
}
