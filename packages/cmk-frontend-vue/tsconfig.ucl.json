{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "weaki18nString.d.ts",
    "src/**/*",
    "ui-component-library/**/*",
    "ui-component-library/**/*.vue"
  ],
  "exclude": ["src/lib/i18nString.ts"],
  "compilerOptions": {
    // Own build info, see tsconfig.test.json.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ucl.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "cmk-ui-library/lib/i18nString": ["weaki18nString.d.ts"],
      "@/*": ["./src/*"],
      "@ucl/*": ["./ui-component-library/*"],
      "*": ["./node_modules/*", "../../bazel-bin/packages/cmk-frontend-vue/node_modules/*"]
    }
  }
}
