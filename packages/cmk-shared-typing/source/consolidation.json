{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "consolidation_function",
  "anyOf": [
    { "$ref": "#/$defs/consolidation_gauge" },
    { "$ref": "#/$defs/consolidation_sum" },
    { "$ref": "#/$defs/consolidation_histogram_scalar" },
    { "$ref": "#/$defs/consolidation_histogram_quantile" },
    { "$ref": "#/$defs/consolidation_histogram_preserve_quantile" },
    { "$ref": "#/$defs/consolidation_histogram_fraction_below" },
    { "$ref": "#/$defs/consolidation_histogram_preserve_fraction_below" },
    { "$ref": "#/$defs/consolidation_histogram_fraction_between" },
    { "$ref": "#/$defs/consolidation_histogram_preserve_fraction_between" }
  ],
  "$defs": {
    "gauge_function": {
      "type": "string",
      "enum": ["gauge_last", "gauge_max", "gauge_avg", "gauge_min"]
    },
    "sum_function": {
      "type": "string",
      "enum": ["sum_rate", "sum_last_raw", "sum_delta"]
    },
    "histogram_function": {
      "type": "string",
      "enum": [
        "histogram_quantile",
        "histogram_count_delta",
        "histogram_count_rate",
        "histogram_sum_rate",
        "histogram_sum_delta",
        "histogram_sum_raw",
        "histogram_fraction_below",
        "histogram_fraction_between"
      ]
    },
    "histogram_preserve_function": {
      "type": "string",
      "enum": [
        "histogram_preserve_quantile",
        "histogram_preserve_fraction_below",
        "histogram_preserve_fraction_between"
      ]
    },
    "consolidation_function_name": {
      "anyOf": [
        { "$ref": "#/$defs/gauge_function" },
        { "$ref": "#/$defs/sum_function" },
        { "$ref": "#/$defs/histogram_function" },
        { "$ref": "#/$defs/histogram_preserve_function" }
      ]
    },
    "consolidation_group_by_key": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["resource", "scope", "data_point"] },
        "key": { "type": "string" }
      },
      "required": ["kind", "key"]
    },
    "consolidation_gauge": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["gauge"] },
        "function": { "$ref": "#/$defs/gauge_function" },
        "lookback_seconds": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds"]
    },
    "consolidation_sum": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sum"] },
        "function": { "$ref": "#/$defs/sum_function" },
        "lookback_seconds": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds"]
    },
    "consolidation_histogram_scalar": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": {
          "type": "string",
          "enum": [
            "histogram_count_delta",
            "histogram_count_rate",
            "histogram_sum_rate",
            "histogram_sum_delta",
            "histogram_sum_raw"
          ]
        },
        "lookback_seconds": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds"]
    },
    "consolidation_histogram_quantile": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_quantile"] },
        "lookback_seconds": { "type": "number" },
        "percentile": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds", "percentile"]
    },
    "consolidation_histogram_preserve_quantile": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_preserve_quantile"] },
        "lookback_seconds": { "type": "number" },
        "percentile": { "type": "number" },
        "group_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/consolidation_group_by_key" }
        }
      },
      "required": ["type", "function", "lookback_seconds", "percentile", "group_by"]
    },
    "consolidation_histogram_fraction_below": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_fraction_below"] },
        "lookback_seconds": { "type": "number" },
        "threshold": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds", "threshold"]
    },
    "consolidation_histogram_preserve_fraction_below": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_preserve_fraction_below"] },
        "lookback_seconds": { "type": "number" },
        "threshold": { "type": "number" },
        "group_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/consolidation_group_by_key" }
        }
      },
      "required": ["type", "function", "lookback_seconds", "threshold", "group_by"]
    },
    "consolidation_histogram_fraction_between": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_fraction_between"] },
        "lookback_seconds": { "type": "number" },
        "lower_threshold": { "type": "number" },
        "upper_threshold": { "type": "number" }
      },
      "required": ["type", "function", "lookback_seconds", "lower_threshold", "upper_threshold"]
    },
    "consolidation_histogram_preserve_fraction_between": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["histogram"] },
        "function": { "type": "string", "enum": ["histogram_preserve_fraction_between"] },
        "lookback_seconds": { "type": "number" },
        "lower_threshold": { "type": "number" },
        "upper_threshold": { "type": "number" },
        "group_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/consolidation_group_by_key" }
        }
      },
      "required": [
        "type",
        "function",
        "lookback_seconds",
        "lower_threshold",
        "upper_threshold",
        "group_by"
      ]
    }
  }
}
