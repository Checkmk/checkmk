{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "global_settings_app",
  "properties": {
    "title": { "type": "string" },
    "domain": {
      "description": "event console or global settings?",
      "$ref": "#/$defs/global_settings_domain"
    },
    "scope": {
      "description": "Whether the shown settings apply to all sites or to one specific site.",
      "anyOf": [
        { "$ref": "#/$defs/global_settings_scope_global" },
        { "$ref": "#/$defs/global_settings_scope_site" }
      ]
    },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/global_settings_topic" }
    }
  },
  "required": ["title", "domain", "scope", "topics"],
  "$defs": {
    "global_settings_domain": {
      "type": "string",
      "enum": ["global_settings", "event_console"]
    },
    "global_settings_scope_global": {
      "type": "object",
      "title": "global_settings_scope_global",
      "properties": {
        "type": {
          "type": "string",
          "const": "global"
        }
      },
      "required": ["type"]
    },
    "global_settings_scope_site": {
      "type": "object",
      "title": "global_settings_scope_site",
      "properties": {
        "type": {
          "type": "string",
          "const": "site"
        },
        "site_id": {
          "type": "string"
        }
      },
      "required": ["type", "site_id"]
    },
    "global_settings_topic": {
      "type": "object",
      "properties": {
        "icon": { "$ref": "icon.json#/$defs/icon_names" },
        "headline": { "type": "string" },
        "subline": { "type": "string" },
        "warning": {
          "description": "Warning shown at the top of the topic, e.g. for internal developer settings.",
          "type": ["string", "null"]
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/global_settings_variable" }
        }
      },
      "required": ["icon", "headline", "subline", "warning", "variables"]
    },
    "global_settings_variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "spec": { "$ref": "vue_formspec/components.json#/$defs/components" },
        "value": {},
        "modified": {
          "description": "Whether the variable is explicitly configured in the scope of this app.",
          "type": "boolean"
        }
      },
      "required": ["name", "spec", "value", "modified"]
    }
  }
}
