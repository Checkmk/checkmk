{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Monitoring - All Hosts App",
  "$id": "../all_hosts.json",
  "allOf": [{ "$ref": "monitoring/_base.json" }],
  "properties": {
    "user_id": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/site" }
    },
    "edition": { "$ref": "monitoring/_base.json#/$defs/edition" },
    "show_relations": {
      "type": "boolean",
      "default": false
    },
    "export_event": {
      "type": "string"
    }
  },
  "required": ["user_id", "site", "sites", "edition", "export_event"],
  "$defs": {
    "site": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alias": { "type": "string" }
      },
      "required": ["id", "alias"]
    }
  }
}
