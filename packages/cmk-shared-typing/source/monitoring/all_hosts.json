{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Monitoring - All Hosts App",
  "$id": "../all_hosts.json",
  "allOf": [{ "$ref": "monitoring/_base.json" }],
  "properties": {
    "user_id": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/site" }
    },
    "edition": { "$ref": "#/$defs/edition" }
  },
  "required": ["user_id", "site", "sites", "edition"],
  "$defs": {
    "edition": {
      "type": "string",
      "enum": ["community", "pro", "ultimate", "ultimatemt", "cloud"]
    },
    "site": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alias": { "type": "string" }
      },
      "required": ["id", "alias"]
    }
  }
}
