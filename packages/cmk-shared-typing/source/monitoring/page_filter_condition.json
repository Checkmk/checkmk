{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitoring Page Filter Condition",
  "description": "The conditions the column filters of a monitoring page can show, as field:op. The frontend derives them from the columns of the page, and the columns.test.ts of each page in cmk-frontend-vue/tests/monitoring (all-hosts, all-services, host-services) keeps its list in step with them. The backend reads it to build only links whose every condition the page shows.",
  "anyOf": [
    {
      "$ref": "#/$defs/all_hosts_filter_condition"
    },
    {
      "$ref": "#/$defs/all_services_filter_condition"
    },
    {
      "$ref": "#/$defs/host_services_filter_condition"
    }
  ],
  "$defs": {
    "all_hosts_filter_condition": {
      "title": "All Hosts Filter Condition",
      "description": "The conditions the column filters of All hosts can show, as field:op.",
      "type": "string",
      "enum": [
        "acknowledged:eq",
        "active_checks_disabled:eq",
        "address:contains",
        "address:matches",
        "address:one_of",
        "alias:contains",
        "alias:matches",
        "alias:one_of",
        "contact_groups:all_of",
        "contact_groups:one_of",
        "contacts:contains",
        "contacts:matches",
        "contacts:one_of",
        "folder:contains",
        "folder:matches",
        "folder:one_of",
        "groups:all_of",
        "groups:one_of",
        "has_comments:eq",
        "in_check_period:eq",
        "in_downtime:eq",
        "in_notification_period:eq",
        "in_service_period:eq",
        "is_flapping:eq",
        "labels:all_of",
        "labels:one_of",
        "last_check:gte",
        "last_check:lte",
        "last_state_change:gte",
        "last_state_change:lte",
        "name:contains",
        "name:matches",
        "name:one_of",
        "notifications_enabled:eq",
        "num_services:eq",
        "num_services:gt",
        "num_services:gte",
        "num_services:lt",
        "num_services:lte",
        "num_services_crit:eq",
        "num_services_crit:gt",
        "num_services_crit:gte",
        "num_services_crit:lt",
        "num_services_crit:lte",
        "num_services_ok:eq",
        "num_services_ok:gt",
        "num_services_ok:gte",
        "num_services_ok:lt",
        "num_services_ok:lte",
        "num_services_pending:eq",
        "num_services_pending:gt",
        "num_services_pending:gte",
        "num_services_pending:lt",
        "num_services_pending:lte",
        "num_services_unknown:eq",
        "num_services_unknown:gt",
        "num_services_unknown:gte",
        "num_services_unknown:lt",
        "num_services_unknown:lte",
        "num_services_warn:eq",
        "num_services_warn:gt",
        "num_services_warn:gte",
        "num_services_warn:lt",
        "num_services_warn:lte",
        "passive_checks_disabled:eq",
        "site_id:one_of",
        "stale:eq",
        "state:one_of",
        "tags:all_of",
        "tags:one_of"
      ]
    },
    "all_services_filter_condition": {
      "title": "All Services Filter Condition",
      "description": "The conditions the column filters of All services can show, as field:op.",
      "type": "string",
      "enum": [
        "acknowledged:eq",
        "active_checks_disabled:eq",
        "check_crashed:eq",
        "contact_groups:all_of",
        "contact_groups:one_of",
        "contacts:contains",
        "contacts:matches",
        "contacts:one_of",
        "groups:all_of",
        "groups:one_of",
        "has_comments:eq",
        "host_name:contains",
        "host_name:matches",
        "host_name:one_of",
        "host_state:one_of",
        "in_check_period:eq",
        "in_downtime:eq",
        "in_notification_period:eq",
        "in_service_period:eq",
        "is_flapping:eq",
        "labels:all_of",
        "labels:one_of",
        "last_check:gte",
        "last_check:lte",
        "last_state_change:gte",
        "last_state_change:lte",
        "name:contains",
        "name:matches",
        "name:one_of",
        "notifications_enabled:eq",
        "passive_checks_disabled:eq",
        "site_id:one_of",
        "stale:eq",
        "state:one_of",
        "summary:contains",
        "summary:matches",
        "summary:one_of",
        "tags:all_of",
        "tags:one_of"
      ]
    },
    "host_services_filter_condition": {
      "title": "Host Services Filter Condition",
      "description": "The conditions the column filters of Services of host can show, as field:op.",
      "type": "string",
      "enum": [
        "acknowledged:eq",
        "active_checks_disabled:eq",
        "check_crashed:eq",
        "contact_groups:all_of",
        "contact_groups:one_of",
        "contacts:contains",
        "contacts:matches",
        "contacts:one_of",
        "groups:all_of",
        "groups:one_of",
        "has_comments:eq",
        "in_check_period:eq",
        "in_downtime:eq",
        "in_notification_period:eq",
        "in_service_period:eq",
        "is_flapping:eq",
        "labels:all_of",
        "labels:one_of",
        "last_check:gte",
        "last_check:lte",
        "last_state_change:gte",
        "last_state_change:lte",
        "name:contains",
        "name:matches",
        "name:one_of",
        "notifications_enabled:eq",
        "passive_checks_disabled:eq",
        "stale:eq",
        "state:one_of",
        "summary:contains",
        "summary:matches",
        "summary:one_of",
        "tags:all_of",
        "tags:one_of"
      ]
    }
  }
}
