{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "product_usage_analytics_config",
  "properties": {
    "global_settings_link": {
      "type": "string"
    },
    "manifest_link": {
      "type": "string"
    },
    "enabled_choice_id": {
      "type": "string",
      "description": "The value the global setting's form uses for the choice to enable product usage analytics"
    },
    "activate_changes_link": {
      "type": "string"
    },
    "reminder_cookie": {
      "$ref": "#/$defs/reminder_cookie"
    }
  },
  "required": [
    "global_settings_link",
    "manifest_link",
    "enabled_choice_id",
    "activate_changes_link",
    "reminder_cookie"
  ],
  "$defs": {
    "reminder_cookie": {
      "type": "object",
      "description": "The cookie the pop-up sets when the user defers the decision. The pop-up is shown again once its timestamp is older than the reminder interval.",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "max_age_seconds": {
          "type": "integer"
        }
      },
      "required": ["name", "path", "max_age_seconds"]
    }
  }
}
