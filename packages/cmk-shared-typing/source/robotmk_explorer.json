{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExplorerApp",
  "type": "object",
  "properties": {
    "global_time_picker": { "$ref": "global_time_picker.json#" },
    "sites": {
      "description": "The sites the user may see, one column each, in display order.",
      "type": "array",
      "items": { "$ref": "#/$defs/explorer_site" }
    },
    "mock_data": {
      "description": "Whether to request the mock data of the list buckets endpoint.",
      "type": "boolean"
    },
    "docs_url_synthetic_monitoring": { "type": "string" },
    "docs_url_backend_setup": { "type": "string" }
  },
  "required": [
    "global_time_picker",
    "sites",
    "mock_data",
    "docs_url_synthetic_monitoring",
    "docs_url_backend_setup"
  ],
  "$defs": {
    "explorer_site": {
      "title": "ExplorerSite",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alias": { "type": "string" }
      },
      "required": ["id", "alias"]
    }
  }
}
