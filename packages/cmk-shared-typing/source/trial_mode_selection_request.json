{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "trial_mode_selection_request",
  "properties": {
    "selection": { "title": "Selection", "enum": ["trial", "unverified_trial", "customer"] },
    "verification_mode": { "title": "VerificationMode", "enum": ["online", "offline"] },
    "unverified_reason": {
      "title": "UnverifiedTrialReason",
      "enum": ["offline", "code_entry_error"],
      "description": "Why the trial continues unverified. Only with the unverified_trial selection."
    }
  },
  "required": ["selection"]
}
