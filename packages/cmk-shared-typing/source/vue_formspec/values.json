{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "condition_choices_value": {
      "type": "object",
      "properties": {
        "group_name": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "title": "eq",
              "type": "object",
              "properties": {
                "oper_eq": {
                  "type": "string"
                }
              },
              "required": ["oper_eq"]
            },
            {
              "title": "ne",
              "type": "object",
              "properties": {
                "oper_ne": {
                  "type": "string"
                }
              },
              "required": ["oper_ne"]
            },
            {
              "title": "or",
              "type": "object",
              "properties": {
                "oper_or": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["oper_or"]
            },
            {
              "title": "nor",
              "type": "object",
              "properties": {
                "oper_nor": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["oper_nor"]
            }
          ]
        }
      },
      "required": ["group_name", "value"]
    },
    "binary_condition_choices_operator": {
      "type": "string",
      "enum": ["and", "or", "not"]
    },
    "binary_condition_choices_value": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "binary_condition_choices_group",
        "properties": {
          "operator": {
            "$ref": "#/$defs/binary_condition_choices_operator"
          },
          "label_group": {
            "type": "array",
            "items": {
              "type": "object",
              "title": "binary_condition_choices_item",
              "properties": {
                "operator": {
                  "$ref": "#/$defs/binary_condition_choices_operator"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": ["operator", "label"]
            }
          }
        },
        "required": ["operator", "label_group"]
      }
    },
    "data_backend_implied_change": {
      "type": "object",
      "description": "An implied change of a save of the data backend setting, as listed for acceptance.",
      "properties": {
        "identity": {
          "type": "string",
          "description": "Identifies the change across saves: an acceptance covers the changes whose identities it lists."
        },
        "text": {
          "type": "string",
          "description": "The change as shown to the admin."
        },
        "new": {
          "type": "boolean",
          "description": "Whether the save answered an earlier refusal whose list did not show this change."
        }
      },
      "required": ["identity", "text", "new"]
    },
    "data_backend_implied_changes_acceptance": {
      "type": "object",
      "description": "The implied changes a save of the data backend setting is refused for, and whether the admin accepts them. No form spec element has this value: the refusal delivers it as the replacement value of its validation message at the form data key \"implied_changes_acceptance\", and the next save submits it back under that key.",
      "properties": {
        "implied_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_backend_implied_change"
          }
        },
        "accepted": {
          "type": "boolean",
          "description": "Whether the admin accepts the listed changes."
        }
      },
      "required": ["implied_changes", "accepted"]
    },
    "values": {
      "oneOf": [
        {
          "$ref": "#/$defs/condition_choices_value"
        },
        {
          "$ref": "#/$defs/binary_condition_choices_value"
        },
        {
          "$ref": "#/$defs/data_backend_implied_changes_acceptance"
        }
      ]
    }
  }
}
