#!/bin/bash

# Intended for manual local testing by development
# Already included in CI pipeline
#
# Builds mk-oracle hermetically with Bazel (the same binary that is shipped)
# and runs the system tests against it.
#
# Usage:
#   ./run-pytests

set -e

if [ $# -ne 0 ]; then
    echo "Usage: $0" >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"
bazel build //packages/mk-oracle
BINARY_PATH="$REPO_ROOT/$(bazel cquery --output=files //packages/mk-oracle 2>/dev/null)"

pytest --mk-oracle-binary-path="$BINARY_PATH" "$REPO_ROOT/tests/system/mk_oracle"
